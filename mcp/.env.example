COMPOSE_PROJECT_NAME=io_gitlab-mcp

# --- Porta exposta pelo serviço ---
PORT=127.0.0.1:3002

# --- GitLab OAuth Application ---
# Criar em: https://git.embrapa.io (Admin Area > Applications)
# Redirect URI: https://mcp.git.embrapa.io/callback
# Confidencial: desmarcado (usa PKCE)
# Escopos: api, read_api, read_user
GITLAB_OAUTH_APP_ID=

# --- Instância do GitLab ---
GITLAB_API_URL=https://git.embrapa.io/api/v4

# --- URL pública do MCP Server ---
MCP_SERVER_URL=https://mcp.git.embrapa.io

# --- Limites (opcionais) ---
MAX_SESSIONS=500
MAX_REQUESTS_PER_MINUTE=30
SESSION_TIMEOUT_SECONDS=3600
